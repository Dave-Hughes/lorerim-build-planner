# Copy to .env.local for local development. Never commit .env.local.

# Neon "dev" branch connection string (Neon console > lorerim-build-planner > dev > Connect).
# The app and the migration script refuse to run if this points at staging or production.
DATABASE_URL=

# Random 32-byte secret: openssl rand -base64 32
AUTH_SECRET=

# Discord application (discord.com/developers/applications) > OAuth2.
# Redirect: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Only needed when testing a production build locally with `next start`.
# AUTH_TRUST_HOST=true
